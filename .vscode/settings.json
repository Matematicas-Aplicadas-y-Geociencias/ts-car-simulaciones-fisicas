{
  "latex-workshop.latex.rootFile": "PROYECTO/report.tex",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.watch.delay": 250,
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.recipe.default.first": "pdflatex",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.autoRefresh.enabled": true,
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 250,

  "fortran.fortls.directories": [
    "${workspaceFolder}/SECUENCIAL/calor2D",
    "${workspaceFolder}/ACC/paralelo/calor2D",
    "${workspaceFolder}/OMP/paralelo/calor2D"
  ],
  "fortran.linter.compiler": "Disabled"
}
